      "events": [["not_sent", "not_accepted"]],
      "outstanding": [0],
      "uncertain": false
    },
    {
      "name": "client_disconnect_is_not_backend_end",
      "events": [["send_started", "none"], ["streaming", "none"], ["outcome_unknown", "none"]],
      "outstanding": [1, 1, 1],
      "uncertain": true
    },
    {
      "name": "late_reconciliation",
      "events": [["send_started", "none"], ["outcome_unknown", "none"], ["cancel_confirmed", "ended"]],
      "outstanding": [1, 1, 0],
      "uncertain": false
    },
    {
      "name": "http_failure_without_termination_evidence",
      "events": [["send_started", "none"], ["failed", "none"]],
      "outstanding": [1, 1],
      "uncertain": true
    },
    {
      "name": "definite_backend_rejection",
      "events": [["send_started", "none"], ["failed", "not_accepted"]],
